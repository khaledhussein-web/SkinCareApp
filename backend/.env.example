PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=....
DB_NAME=skincare_db
DB_SSL=false

# Optional if you prefer a single connection string.
# DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/skincare_db

DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=change_me_in_production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change_me_refresh_in_production
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/auth

# Image analysis provider: auto | openai | endpoint | none
IMAGE_ANALYSIS_PROVIDER=auto
# Optional custom image analyzer endpoint (expects JSON with imageBase64 + questionnaireData)
IMAGE_ANALYSIS_ENDPOINT=
IMAGE_ANALYSIS_TIMEOUT_MS=15000
# Example for local FastAPI microservice:
# IMAGE_ANALYSIS_PROVIDER=endpoint
# IMAGE_ANALYSIS_ENDPOINT=http://127.0.0.1:8000/predict

# OpenAI vision configuration (used when provider is openai/auto)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

# Web3Forms contact forwarding
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit
WEB3FORMS_FROM_NAME=SkinCare AI Support
WEB3FORMS_TIMEOUT_MS=10000

# Chatbot provider: ollama | fallback
CHAT_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=150000
OLLAMA_TEMPERATURE=0.65
OLLAMA_MAX_TOKENS=400
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_CONTINUATION_MAX_ROUNDS=1
OLLAMA_CONTINUATION_TOKENS=220
CHAT_HISTORY_MESSAGE_LIMIT=6
